#!/usr/bin/env bash
set -euo pipefail

[ "$UID" = 0 ] && {
    echo "Do not run me as root"
    exit 1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
if [[ "$SCRIPT_DIR" =~ ^/usr/ ]]; then
    cd /usr/share/pacpac
else
    cd "$SCRIPT_DIR"
fi

# Configuration file location in user's home directory
PKGFILE="${XDG_CONFIG_HOME:-$HOME/.config}/pacpac/packages.yml"

# Ensure config directory exists
mkdir -p "$(dirname "$PKGFILE")"

# Create default packages.yml if it doesn't exist
if [ ! -f "$PKGFILE" ]; then
    cat > "$PKGFILE" << 'EOF'
# PacPac Package Configuration
# This file is managed by pacpac
pacpac_packages:
  # Add your packages here
  # Example:
  #   - name: vim
  #   - name: git
EOF
    echo -e "\033[1;32mCreated default package list at $PKGFILE\033[0m"
fi

HOSTNAME=$(hostname)
ANSIBLE_PLAYBOOK="pacpac.yml"

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NOCOLOR='\033[0m'

show_diff()
{
    ansible-playbook pacpac.yml \
        --extra-vars "pacpac_config_file=$PKGFILE" \
        2>&1 | grep -E "^(Extras|Missing|  )" | head -50 || true
}

ask()
{
    local prompt="$1"
    local response
    while true; do
        echo -e "${GREEN}$prompt ${YELLOW}[Y/n]${NOCOLOR}: "
        read -r response
        case "$response" in
            "" | [Yy]*) return 0 ;;
            [Nn]*) return 1 ;;
            *) echo "Please answer y or n (or press Enter for yes)." ;;
        esac
    done
}

interactive_menu()
{
    echo -e "${GREEN}========================================${NOCOLOR}"
    echo -e "${GREEN}  PacPac - Interactive Package Manager${NOCOLOR}"
    echo -e "${GREEN}========================================${NOCOLOR}"
    echo -e "${YELLOW}Config file: $PKGFILE${NOCOLOR}"
    echo ""
    
    show_diff
    
    echo ""
    echo -e "${GREEN}What would you like to do?${NOCOLOR}"
    echo "  1) Edit package list (opens in editor)"
    echo "  2) Show package differences again"
    echo "  3) Exit"
    echo ""
    
    while true; do
        echo -e "${GREEN}Enter choice [1-3]:${NOCOLOR} "
        read -r choice
        case "$choice" in
            1)
                ${EDITOR:-vim} "$PKGFILE"
                echo -e "${GREEN}Package list updated. Re-running diff...${NOCOLOR}"
                echo ""
                show_diff
                ;;
            2)
                echo ""
                show_diff
                ;;
            3)
                echo -e "${GREEN}Goodbye!${NOCOLOR}"
                exit 0
                ;;
            *)
                echo "Invalid choice. Please enter 1, 2, or 3."
                ;;
        esac
    done
}

interactive_menu
